# Copy to .env and replace the password before starting the stack.
DEPOT_POSTGRES_DB=depot
DEPOT_POSTGRES_USER=depot
DEPOT_POSTGRES_PASSWORD=replace-with-a-strong-local-password

# The web UI is available at http://127.0.0.1:19096 by default.
DEPOT_PORT=19096

# Optional stable ID for the single local user.
DEPOT_USER_ID=00000000-0000-0000-0000-000000000001
