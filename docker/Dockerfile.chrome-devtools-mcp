FROM node:22-bookworm-slim
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates chromium curl && rm -rf /var/lib/apt/lists/*
RUN npm install --global chrome-devtools-mcp@1.6.0 && npm cache clean --force
COPY docker/chrome-devtools-mcp-entrypoint.sh /usr/local/bin/depot-chrome-devtools-mcp
RUN chmod 755 /usr/local/bin/depot-chrome-devtools-mcp
ENTRYPOINT ["/usr/local/bin/depot-chrome-devtools-mcp"]
